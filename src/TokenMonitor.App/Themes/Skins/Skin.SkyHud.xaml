<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
      ============================================================
      Skin 4 · SkyHud 苍穹空域（天青浅底 · 座舱 HUD）
      雷达扫描 + 尾焰橙 + 瞄准框；全员大圆角与圆头线帽。
      令牌唯一权威：design/03-ui-spec.md §2.2 / §3.4
      ============================================================
    -->

    <sys:String x:Key="Tg.Skin.Name">SkyHud</sys:String>

    <!-- 背景：天青云白渐变（云朵椭圆由窗口模板在 IsSkySkin 时叠加） -->
    <LinearGradientBrush x:Key="Tg.Bg.Window" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#DCECFA" Offset="0"/>
        <GradientStop Color="#F3F9FF" Offset="0.42"/>
        <GradientStop Color="#E7F2FC" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Tg.Bg.Panel" Color="#EBFFFFFF"/>
    <SolidColorBrush x:Key="Tg.Bg.Card" Color="#EBFFFFFF"/>
    <SolidColorBrush x:Key="Tg.Bg.CardSel" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Tg.Bg.Inset" Color="#F2F8FE"/>
    <SolidColorBrush x:Key="Tg.Bg.TitleBar" Color="#8CFFFFFF"/>
    <SolidColorBrush x:Key="Tg.Bg.Status" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="Tg.Mask" Color="#8010304F"/>

    <!-- 描边（1.5px 海军蓝细环） -->
    <SolidColorBrush x:Key="Tg.Stroke.Strong" Color="#6610304F"/>
    <SolidColorBrush x:Key="Tg.Stroke.Hair" Color="#2910304F"/>
    <SolidColorBrush x:Key="Tg.Stroke.Hover" Color="#6610304F"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="Tg.Ink.Primary" Color="#10304F"/>
    <SolidColorBrush x:Key="Tg.Ink.Second" Color="#48688C"/>
    <SolidColorBrush x:Key="Tg.Ink.Faint" Color="#93A9C4"/>

    <!-- 强调 -->
    <SolidColorBrush x:Key="Tg.Accent.Brand" Color="#FF5A1F"/>
    <SolidColorBrush x:Key="Tg.Accent.Soft" Color="#FDECE4"/>
    <SolidColorBrush x:Key="Tg.OnAccent" Color="#FFFFFF"/>

    <!-- 图表 -->
    <SolidColorBrush x:Key="Tg.Chart.H" Color="#1B7BD6"/>
    <SolidColorBrush x:Key="Tg.Chart.M" Color="#E23A26"/>
    <SolidColorBrush x:Key="Tg.Chart.O" Color="#10304F"/>
    <SolidColorBrush x:Key="Tg.Chart.Line" Color="#1B7BD6"/>
    <SolidColorBrush x:Key="Tg.Chart.LineDot" Color="#FF5A1F"/>
    <SolidColorBrush x:Key="Tg.Chart.Grid" Color="#D7E7F6"/>
    <SolidColorBrush x:Key="Tg.Ring.Stroke" Color="#1B7BD6"/>
    <SolidColorBrush x:Key="Tg.Ring.Track" Color="#E3EEF8"/>

    <!-- 语义色（UTC 口径文字 #B26A00） -->
    <SolidColorBrush x:Key="Tg.State.Danger" Color="#E23A26"/>
    <SolidColorBrush x:Key="Tg.State.Warn" Color="#F5A623"/>
    <SolidColorBrush x:Key="Tg.WarnInk" Color="#B26A00"/>
    <SolidColorBrush x:Key="Tg.State.Ok" Color="#18A05E"/>
    <SolidColorBrush x:Key="Tg.State.Info" Color="#1B7BD6"/>

    <!-- 漏抓横幅（警戒斜纹底纹由模板叠加） -->
    <SolidColorBrush x:Key="Tg.Banner.Bg" Color="#FDECE4"/>
    <SolidColorBrush x:Key="Tg.Banner.Stroke" Color="#F0BBA9"/>
    <SolidColorBrush x:Key="Tg.Banner.Ink" Color="#8C2417"/>
    <SolidColorBrush x:Key="Tg.Banner.TagInk" Color="#FFFFFF"/>

    <!-- 提供商徽章 -->
    <SolidColorBrush x:Key="Tg.Provider.Glm" Color="#10304F"/>
    <SolidColorBrush x:Key="Tg.Provider.DeepSeek" Color="#1B7BD6"/>
    <SolidColorBrush x:Key="Tg.Provider.Qwen" Color="#5C6BC0"/>
    <SolidColorBrush x:Key="Tg.Provider.Default" Color="#18A05E"/>

    <!-- 圆角阶梯：窗体20 / 卡15 / 菜单16 / 对话框20 / 控件10 / 徽章999 / 占比条 pill -->
    <CornerRadius x:Key="Tg.Radius.Window">20</CornerRadius>
    <CornerRadius x:Key="Tg.Radius.Card">15</CornerRadius>
    <CornerRadius x:Key="Tg.Radius.Menu">16</CornerRadius>
    <CornerRadius x:Key="Tg.Radius.Dialog">20</CornerRadius>
    <CornerRadius x:Key="Tg.Radius.Control">10</CornerRadius>
    <CornerRadius x:Key="Tg.Radius.Badge">999</CornerRadius>
    <CornerRadius x:Key="Tg.Radius.Bar">999</CornerRadius>
    <CornerRadius x:Key="Tg.Radius.Pill">999</CornerRadius>

    <!-- 描边粗细（1.5px） -->
    <Thickness x:Key="Tg.Window.BorderThickness">1.5</Thickness>
    <Thickness x:Key="Tg.Card.BorderThickness">1.5</Thickness>

    <!-- 字体栈（Bahnschrift DIN 座舱体） -->
    <FontFamily x:Key="Tg.Font.Display">Bahnschrift, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Tg.Font.Num">Bahnschrift, Consolas, Segoe UI</FontFamily>
    <FontFamily x:Key="Tg.Font.Body">Microsoft YaHei UI, Bahnschrift, Segoe UI</FontFamily>

    <!-- 纹理：条内刻纹 / 警戒斜纹 135°(p≈20px) / 云层透明占位 -->
    <DrawingBrush x:Key="Tg.Texture.Bars" TileMode="Tile" Viewport="0,0,9,7" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="M0,0 L1,0 L1,7 L0,7 Z" Brush="#0E10304F"/>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="Tg.Texture.Banner" TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 L14,0 L0,14 Z" Brush="#0EE23A26"/>
                <GeometryDrawing Geometry="M0,28 L28,0 L28,14 L14,28 Z" Brush="#0EE23A26"/>
                <GeometryDrawing Geometry="M28,14 L28,28 L14,28 Z" Brush="#0EE23A26"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="Tg.Texture.Grid">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="M0,0 L28,0 L28,28 L0,28 Z" Brush="#00FFFFFF"/>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- 倍率徽章（S4 琥珀胶囊） -->
    <SolidColorBrush x:Key="Tg.MulChip.Border" Color="#F5A623"/>
    <SolidColorBrush x:Key="Tg.MulChip.Bg" Color="#FFF3DC"/>
    <SolidColorBrush x:Key="Tg.MulChip.Ink" Color="#B26A00"/>
    <DoubleCollection x:Key="Tg.MulChip.Dash"/>

    <!-- 阴影（§3.4：S4 窗体 Blur 28 · Depth 12 · 海军 .28；环境影 Blur 10 · Depth 3 · #1B5A96 .10） -->
    <DropShadowEffect x:Key="Tg.Shadow.Window" x:Shared="False"
                      BlurRadius="28" ShadowDepth="12" Direction="270" Color="#10304F" Opacity="0.28"/>
    <DropShadowEffect x:Key="Tg.Shadow.Float" x:Shared="False"
                      BlurRadius="28" ShadowDepth="12" Direction="270" Color="#10304F" Opacity="0.28"/>
    <DropShadowEffect x:Key="Tg.Shadow.Env" x:Shared="False"
                      BlurRadius="10" ShadowDepth="3" Direction="270" Color="#1B5A96" Opacity="0.10"/>

</ResourceDictionary>
