<dialogs:ShellDialog
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:TokenMonitor.App.Dialogs"
        x:Class="TokenMonitor.App.Dialogs.OpLogDialog"
        HeaderTag="LOG" HeaderTitle="操作日志" ModelTag="{Binding ScopeText}"
        FooterHint="保留最近操作记录（读取恒 500 条）"
        ConfirmText="关闭" ShowCancel="False" Width="640">
    <dialogs:ShellDialog.Content>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                <TextBlock Text="范围" Style="{StaticResource Tg.MicroLabel}" Margin="0,0,7,0"/>
                <ComboBox Style="{StaticResource Tg.Combo}" Width="220" x:Name="ScopeBox"
                          SelectionChanged="Scope_Changed">
                    <ComboBoxItem Content="全部模型" Tag="{x:Null}" IsSelected="True"/>
                    <ComboBoxItem Content="仅当前选中模型" Tag="selected"/>
                </ComboBox>
            </StackPanel>
            <Border BorderBrush="{DynamicResource Tg.Stroke.Hair}" BorderThickness="1"
                    CornerRadius="{DynamicResource Tg.Radius.Control}" MaxHeight="330">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Tg.Stroke.Hair}" BorderThickness="0,0,0,1" Padding="9,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="118"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource Tg.NumText}" FontSize="10.5"
                                                   Foreground="{DynamicResource Tg.Ink.Faint}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Action}" Style="{StaticResource Tg.NumText}"
                                                   FontSize="10.5" Foreground="{DynamicResource Tg.Accent.Brand}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Model}" Style="{StaticResource Tg.NumText}"
                                                   FontSize="10.5" Foreground="{DynamicResource Tg.Ink.Second}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Detail}" FontSize="10.5"
                                                   Foreground="{DynamicResource Tg.Ink.Primary}" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </dialogs:ShellDialog.Content>
</dialogs:ShellDialog>
