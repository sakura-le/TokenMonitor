<dialogs:ShellDialog
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:TokenMonitor.App.Dialogs"
        xmlns:infra="clr-namespace:TokenMonitor.App.Infrastructure"
        x:Class="TokenMonitor.App.Dialogs.SettingsDialog"
        HeaderTag="SET" HeaderTitle="设置"
        VersionText="{Binding StatusText}"
        FooterHint="改动随「保存并生效」统一应用；代理地址变更会自动重启监听。高级项（MaxTokens / StripParams / 默认供应商）仍请用「打开配置文件」编辑。"
        ConfirmText="保存并生效" Width="640"
        ScrollViewer.VerticalScrollBarVisibility="Auto">
    <dialogs:ShellDialog.Content>
        <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ============ 代理（config.json） ============ -->
                <TextBlock Text="代理 PROXY（config.json）" Style="{StaticResource Tg.MicroLabel}" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="监听地址" Style="{StaticResource Tg.MicroLabel}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Style="{StaticResource Tg.Input}" Text="{Binding ListenAddr, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Column="3" Text="只许本机回环（127.0.0.1 / localhost / ::1）" Style="{StaticResource Tg.MicroLabel}"
                               VerticalAlignment="Center" Foreground="{DynamicResource Tg.Ink.Faint}"/>
                </Grid>

                <TextBlock Text="供应商（请求 model 命中「模型前缀」即路由到该供应商，密钥落盘自动加密）"
                           Style="{StaticResource Tg.MicroLabel}" Margin="0,0,0,5" TextTrimming="CharacterEllipsis"/>
                <ItemsControl ItemsSource="{Binding Providers}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Tg.Stroke.Hair}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Tg.Radius.Control}"
                                    Background="{DynamicResource Tg.Bg.Inset}" Padding="9,7" Margin="0,0,0,7">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="名称" Style="{StaticResource Tg.MicroLabel}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Style="{StaticResource Tg.Input}"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="3" Text="模型前缀" Style="{StaticResource Tg.MicroLabel}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="4" Style="{StaticResource Tg.Input}"
                                                 Text="{Binding Prefixes, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="请求里 model 的前缀，命中即路由到本供应商；多个用逗号分隔，如 deepseek-,deepseek"/>
                                        <Button Grid.Column="5" Content="删除" Style="{StaticResource Tg.DangerButton}" Margin="8,0,0,0"
                                                Command="{Binding DataContext.RemoveProviderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="上游地址" Style="{StaticResource Tg.MicroLabel}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Style="{StaticResource Tg.Input}"
                                                 Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                    <Grid Grid.Row="2" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="API Key" Style="{StaticResource Tg.MicroLabel}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Style="{StaticResource Tg.Input}"
                                                 Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="+ 添加供应商" Style="{StaticResource Tg.Btn}" Padding="12,5"
                        HorizontalAlignment="Left" Command="{Binding AddProviderCommand}" Margin="0,0,0,12"/>

                <!-- ============ 通用（settings.json） ============ -->
                <TextBlock Text="通用 GENERAL（settings.json）" Style="{StaticResource Tg.MicroLabel}" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="生效基准" Style="{StaticResource Tg.MicroLabel}" VerticalAlignment="Center"
                               ToolTip="决定计价/倍率版本的生效日期与时段按哪个日历解释"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="UTC" GroupName="effbasis" IsChecked="{Binding IsLocalMode, Converter={StaticResource InvBool}}" Margin="0,0,14,0"/>
                        <RadioButton Content="LOCAL（本机时区）" GroupName="effbasis" IsChecked="{Binding IsLocalMode}"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="统计时区" Style="{StaticResource Tg.MicroLabel}" VerticalAlignment="Center"
                               ToolTip="LOCAL 口径按这个时区切日（卡片口径可单独在卡片上切换 UTC/LOCAL）"/>
                    <ComboBox Grid.Column="1" Style="{StaticResource Tg.Combo}" ItemsSource="{Binding Timezones}"
                              SelectedItem="{Binding SelectedTz}"/>
                    <TextBlock Grid.Column="3" Text="改动会重算历史日表" Style="{StaticResource Tg.MicroLabel}" VerticalAlignment="Center"
                               Foreground="{DynamicResource Tg.Ink.Faint}"/>
                </Grid>
                <Grid Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="球透明度" Style="{StaticResource Tg.MicroLabel}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Style="{StaticResource Tg.Slider}" Minimum="20" Maximum="100"
                            Value="{Binding BallOpacityPct}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding BallOpacityPct, StringFormat={}{0:0}%}" Style="{StaticResource Tg.NumText}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <CheckBox Grid.Column="4" Content="悬浮球置顶" IsChecked="{Binding BallTopmost}" VerticalAlignment="Center"/>
                </Grid>
                <CheckBox Content="开机自启（写入当前用户注册表 Run 项）" IsChecked="{Binding AutoStartOn}" Margin="0,0,0,12"/>

                <!-- ============ 高级逃生口 ============ -->
                <StackPanel Orientation="Horizontal">
                    <Button Content="打开配置文件（高级）" Style="{StaticResource Tg.LinkButton}" Command="{Binding OpenConfigFileCommand}"/>
                    <Button Content="打开导出目录" Style="{StaticResource Tg.LinkButton}" Margin="12,0,0,0" Command="{Binding OpenExportDirCommand}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </dialogs:ShellDialog.Content>
</dialogs:ShellDialog>
